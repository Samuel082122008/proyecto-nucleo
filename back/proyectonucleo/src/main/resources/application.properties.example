spring.application.name=proyectonucleo
server.port=8081

spring.datasource.url=jdbc:mysql://HOST:PUERTO/defaultdb?sslMode=REQUIRED&serverTimezone=America/Bogota
spring.datasource.username=USUARIO
spring.datasource.password=CLAVE

spring.jpa.hibernate.ddl-auto=update
